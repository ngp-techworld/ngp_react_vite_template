# Copy to .env (or .env.local) only if you need to change something; the defaults work for local dev.
# Only VITE_ variables reach the browser, and everything in them is public: never put secrets here.
# Validated at startup in src/shared/config.ts.

# --- App ---
VITE_APP_NAME="NGP Starter"

# --- API (Laravel starter, Sanctum SPA cookie auth) ---
# Leave empty to call the API on this app's own origin. In dev, Vite proxies /api, /sanctum and
# /storage to http://127.0.0.1:8000 (see vite.config.ts).
# Set it only when the API is on another origin of the same site, e.g. https://api.example.com
# (the API must then allow this origin in CORS with credentials and in SANCTUM_STATEFUL_DOMAINS).
VITE_API_URL=
